generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String         @id @default(uuid())
  email             String         @unique
  passwordHash      String
  fullName          String
  role              String         @default("STAFF")
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  announcementsSent Announcement[]
  leaveRequests     LeaveRequest[]
  teacherProfile    Teacher?
  studentProfile    Student?
}

model Teacher {
  id              String              @id @default(uuid())
  userId          String?             @unique
  teacherId       String              @unique
  nameKh          String
  nameEn          String?
  firstNameKh     String?
  lastNameKh      String?
  firstNameEn     String?
  lastNameEn      String?
  gender          String
  dob             DateTime?
  phoneNumber     String
  email           String?
  address         String?
  specialty       String
  baseSalary      Float               @default(0.00)
  hourlyRate      Float               @default(0.00)
  status          String              @default("ACTIVE")
  joinDate        DateTime            @default(now())
  photoUrl        String?
  idCardNumber    String?
  nationalCardUrl String?
  degreeUrl       String?
  cvUrl           String?
  contractUrl     String?
  telegramChatId  String?
  shift           String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  attendances     TeacherAttendance[]
  documents       Document[]
  exams           Exam[]
  leaveRequests   LeaveRequest[]
  salaryPayments  SalaryPayment[]
  timetables      Timetable[]
  courses         Course[]
  user            User?               @relation(fields: [userId], references: [id])
}

model Student {
  id                  String          @id @default(uuid())
  userId              String?         @unique
  studentId           String          @unique
  nameKh              String
  nameEn              String?
  firstNameKh         String?
  lastNameKh          String?
  firstNameEn         String?
  lastNameEn          String?
  gender              String
  dob                 DateTime?
  phoneNumber         String?
  guardianName        String?
  guardianPhone       String?
  relationship        String?
  address             String?
  course              String?
  level               String?
  grade               String?
  shift               String?
  status              String          @default("ACTIVE")
  registeredDate      DateTime        @default(now())
  photoUrl            String?
  birthCertificateUrl String?
  idCardUrl           String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  attendances         Attendance[]
  bookBorrowings      BookBorrowing[]
  certificates        Certificate[]
  documents           Document[]
  enrollments         Enrollment[]
  examResults         ExamResult[]
  invoices            Invoice[]
  leaveRequests       LeaveRequest[]
  scores              Score[]
  user                User?           @relation(fields: [userId], references: [id])
}

model Attendance {
  id        String   @id @default(uuid())
  studentId String
  date      DateTime
  status    String
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@index([studentId])
}

model TeacherAttendance {
  id        String   @id @default(uuid())
  teacherId String
  date      DateTime
  status    String
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, date])
}

model Invoice {
  id            String               @id @default(uuid())
  invoiceNumber String               @unique
  studentId     String
  term          String
  amountDue     Float
  amountPaid    Float                @default(0.00)
  status        String               @default("PENDING")
  paymentDate   DateTime?
  paymentMethod String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  student       Student              @relation(fields: [studentId], references: [id])
  transactions  PaymentTransaction[]

  @@index([studentId])
}

model SalaryPayment {
  id            String    @id @default(uuid())
  teacherId     String
  payPeriod     String
  baseSalary    Float
  bonus         Float     @default(0.00)
  deduction     Float     @default(0.00)
  totalPaid     Float
  status        String    @default("PENDING")
  paymentDate   DateTime?
  invoiceNumber String    @unique
  createdAt     DateTime  @default(now())
  teacher       Teacher   @relation(fields: [teacherId], references: [id])

  @@index([teacherId])
}

model CertificateTemplate {
  id           String        @id @default(uuid())
  title        String
  bgImageUrl   String
  contentXml   String?
  createdAt    DateTime      @default(now())
  certificates Certificate[]
}

model Certificate {
  id                String              @id @default(uuid())
  certificateNumber String              @unique
  studentId         String
  templateId        String
  issueDate         DateTime            @default(now())
  gradeTitle        String
  qrCodeUrl         String?
  student           Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  template          CertificateTemplate @relation(fields: [templateId], references: [id])

  @@index([studentId])
  @@index([templateId])
}

model Asset {
  id             String   @id @default(uuid())
  nameKh         String
  nameEn         String?
  descriptionKh  String?
  descriptionEn  String?
  category       String
  quantity       Int      @default(1)
  unitPrice      Float    @default(0.00)
  location       String?
  personInCharge String?
  status         String   @default("ល្អឥតខ្ចោះ")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Expense {
  id            String   @id @default(uuid())
  title         String
  amount        Float
  date          String
  category      String
  paymentMethod String?
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Score {
  id        String   @id @default(uuid())
  studentId String
  month     String
  subject   String
  score     Float
  rank      Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model Timetable {
  id        String   @id @default(uuid())
  teacherId String
  subject   String
  room      String
  dayOfWeek String
  startTime String
  endTime   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
}

model Course {
  id          String       @id @default(uuid())
  title       String
  description String?
  price       Float        @default(0.00)
  duration    String?
  hours       String?
  teacherId   String?
  status      String       @default("ACTIVE")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  teacher     Teacher?     @relation(fields: [teacherId], references: [id])
  enrollments Enrollment[]
  exams       Exam[]

  @@index([teacherId])
}

model Enrollment {
  id        String   @id @default(uuid())
  studentId String
  courseId  String
  date      DateTime @default(now())
  status    String   @default("ENROLLED")
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
}

model LeaveRequest {
  id            String   @id @default(uuid())
  userId        String?
  teacherId     String?
  studentId     String?
  applicantType String?  @default("TEACHER")
  applicantName String?
  applicantCode String?
  type          String
  startDate     DateTime
  endDate       DateTime
  reason        String?
  status        String   @default("PENDING")
  guardianPhone String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  student       Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher       Teacher? @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([teacherId])
  @@index([studentId])
}

model Book {
  id              String          @id @default(uuid())
  title           String
  author          String?
  isbn            String?
  category        String?
  totalCopies     Int             @default(1)
  availableCopies Int             @default(1)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  borrowings      BookBorrowing[]
}

model BookBorrowing {
  id         String    @id @default(uuid())
  bookId     String
  studentId  String
  borrowDate DateTime  @default(now())
  dueDate    DateTime
  returnDate DateTime?
  status     String    @default("BORROWED")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  book       Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  student    Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([bookId])
  @@index([studentId])
}

model Announcement {
  id      String   @id @default(uuid())
  title   String
  content String
  target  String
  sentBy  String
  sentAt  DateTime @default(now())
  user    User     @relation(fields: [sentBy], references: [id])

  @@index([sentBy])
}

model Exam {
  id          String       @id @default(uuid())
  title       String
  description String?
  courseId    String?
  teacherId   String
  duration    Int          @default(60)
  status      String       @default("DRAFT")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  course      Course?      @relation(fields: [courseId], references: [id])
  teacher     Teacher      @relation(fields: [teacherId], references: [id])
  results     ExamResult[]
  questions   Question[]

  @@index([courseId])
  @@index([teacherId])
}

model Question {
  id      String @id @default(uuid())
  examId  String
  text    String
  options String
  answer  String
  points  Int    @default(1)
  exam    Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([examId])
}

model ExamResult {
  id          String   @id @default(uuid())
  examId      String
  studentId   String
  score       Int
  totalPoints Int
  answers     String
  submittedAt DateTime @default(now())
  exam        Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([examId])
  @@index([studentId])
}

model PaymentTransaction {
  id            String   @id @default(uuid())
  invoiceId     String
  transactionId String   @unique
  amount        Float
  currency      String   @default("USD")
  paymentMethod String   @default("KHQR")
  status        String   @default("SUCCESS")
  rawResponse   String?
  paidAt        DateTime @default(now())
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Document {
  id         String   @id @default(uuid())
  title      String
  fileUrl    String
  type       String   @default("OTHER")
  studentId  String?
  teacherId  String?
  uploadedAt DateTime @default(now())
  student    Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher    Teacher? @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([teacherId])
}
